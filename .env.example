# Copy to .env and fill in. Placeholders only: never commit real values.

# --- docker-compose (local Postgres and Redis) ---
KMR_POSTGRES_USER=kmr
KMR_POSTGRES_PASSWORD=change-me-local-only
KMR_POSTGRES_DB=kmr_dev
KMR_POSTGRES_PORT=55432
KMR_REDIS_PORT=56379

# --- backend (read by backend/app/config.py) ---
KMR_APP_ENV=local
KMR_LOG_LEVEL=INFO
KMR_CORS_ORIGINS=["http://localhost:3000"]
# Runtime connection: the restricted app role (subject to Row-Level Security).
KMR_DATABASE_URL=postgresql+psycopg://kmr_app:change-me-app-role@127.0.0.1:55432/kmr_dev
# Owner connection: migrations and test setup only. Never used by request handlers.
KMR_MIGRATION_DATABASE_URL=postgresql+psycopg://kmr:change-me-local-only@127.0.0.1:55432/kmr_dev
KMR_APP_DB_USER=kmr_app
KMR_APP_DB_PASSWORD=change-me-app-role
# Signs CSRF tokens. Generate with: openssl rand -hex 32
KMR_SECRET_KEY=change-me-generate-a-long-random-value
KMR_REDIS_URL=redis://127.0.0.1:56379/0

# Encrypts API-check credentials at rest. Generate with:
#   backend/.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KMR_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- scanner sandbox (docker-compose profile "scanner") ---
# Secret WebSocket path of the browser container. Generate with: openssl rand -hex 16
KMR_SCAN_BROWSER_PATH=change-me-generate-a-long-random-value
KMR_SCAN_BROWSER_WS=ws://172.31.250.10:3000/change-me-generate-a-long-random-value
# Optional Firefox scanning (Chromium stays the default). To enable: set a long random path here,
# rebuild with `make scanner-up`, set the matching WS below, and list it:
#   KMR_SCAN_ENGINES_AVAILABLE=["chromium","firefox"]
# Then run `make scanner-check`: it repeats the sandbox checks for every listed engine.
# WebKit is not offered: it has not passed those checks.
KMR_SCAN_BROWSER_PATH_FIREFOX=
KMR_SCAN_BROWSER_WS_FIREFOX=
KMR_SCAN_PROXY_URL=http://172.31.250.11:3128

# --- frontend (server-side only; read by frontend/src/lib/api.ts) ---
KMR_API_URL=http://127.0.0.1:8000

# Signs and verifies the review sign-offs that gate the learning module's production_ready flag
# (docs/CHILD-LEARNING-SAFEGUARDS.md). Generate with: openssl rand -hex 32. Keep it with the owner.
KMR_SIGNOFF_SECRET=
